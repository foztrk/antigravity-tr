{
  "name": "antigravity-tr",
  "version": "1.0.12",
  "description": "Google Antigravity ve Antigravity IDE için Kapsamlı Türkçe Dil Paketi ve Otomatik Yama Aracı",
  "main": "src/installer.js",
  "bin": {
    "antigravity-tr": "bin/antigravity-tr.js"
  },
  "scripts": {
    "start": "node bin/antigravity-tr.js",
    "install-tr": "node bin/antigravity-tr.js install",
    "restore": "node bin/antigravity-tr.js restore",
    "scan": "node -e \"console.log(require('./src/scanner').scanUiStrings())\"",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "antigravity",
    "antigravity-ide",
    "turkish",
    "turkish-language-pack",
    "turkce",
    "google-antigravity",
    "gemini",
    "ai-ide"
  ],
  "author": "Antigravity Topluluğu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmzoztr/antigravity-tr.git"
  },
  "bugs": {
    "url": "https://github.com/gmzoztr/antigravity-tr/issues"
  },
  "homepage": "https://github.com/gmzoztr/antigravity-tr#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron/asar": "4.3.1",
    "playwright-core": "^1.63.0"
  },
  "files": [
    "bin/",
    "src/",
    "locales/",
    "rules/",
    "scripts/desktop_full_dictionary.json",
    "install.ps1",
    "restore.ps1",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
